# Blender Settings
BLENDER_PATH=/opt/blender/blender
BLENDER_PYTHON=/opt/blender/python/bin/python
BLENDER_GPU_ENABLED=true
BLENDER_GPU_TYPE=CUDA

# Rendering
RENDER_ENGINE=CYCLES
RENDER_SAMPLES=256
RENDER_RESOLUTION=1920x1080
RENDER_FORMAT=PNG

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_WORKERS=4

# Storage
OUTPUT_DIR=./output
CACHE_DIR=./cache
TEMP_DIR=/tmp/3d-agent

# Performance
MAX_WORKERS=4
BATCH_SIZE=2
GPU_MEMORY=8GB

# Logging
LOG_LEVEL=INFO
